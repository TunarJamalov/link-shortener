PORT=3200
HOST=0.0.0.0
TRUST_PROXY=loopback
DATABASE_PATH=./data/links.db

# Public base URL used when displaying short links, e.g. https://go.example.com
BASE_URL=http://localhost:3200

# Admin sign-in. All three are required together. Generate the key with: openssl rand -base64 48
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_ENCRYPTION_KEY=

# Optional bearer token for creating links from scripts: Authorization: Bearer <token>
API_TOKEN=

# 301 (permanent, cached by browsers) or 302 (temporary, every click is counted)
REDIRECT_STATUS=302

# Days of click history to keep (0 = forever)
CLICK_RETENTION_DAYS=365
